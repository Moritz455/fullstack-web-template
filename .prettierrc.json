{
  "tabWidth": 2,
  "useTabs": false,
  "endOfLine": "lf",
  "htmlWhitespaceSensitivity": "css",
  "overrides": [
    {
      "files": "*.html",
      "options": {
        "parser": "html",
        "tabWidth": 2,
        "singleQuote": false
      }
    },
    {
      "files": "*.less",
      "options": {
        "parser": "less",
        "tabWidth": 2,
        "singleQuote": true
      }
    }
  ]
}
