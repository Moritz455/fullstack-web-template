{
  "name": "web-entwicklung-projekt",
  "version": "1.0.1",
  "description": "",
  "private": true,
  "workspaces": [
    "webapp",
    "server",
    "lib"
  ],
  "scripts": {
    "clean": "npm run clean:dist --workspaces --if-present && rm -rf node_modules webapp/node_modules server/node_modules",
    "lint": "npm run lint --workspaces",
    "format": "npm run format --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "predebug": "npm run lint",
    "debug": "npm run debug --workspace=webapp",
    "prebuild": "npm run lint",
    "build": "npm run build --workspace=webapp",
    "start": "npm run start --workspace=server"
  },
  "devDependencies": {
    "lesshint": "^6.3.7",
    "lesshint-reporter-stylish": "^3.0.0",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "semistandard": "^17.0.0",
    "snazzy": "^9.0.0"
  }
}
